---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { cardView } from '../../lib/catalog'
import {
  addButtonLabel,
  canAdd,
  colorChoices,
  initialSelection,
  priceMuted,
  priceText,
  quantityCap,
  quedaUnoTexto,
  showChooseHint,
  sizeChoices,
  stepperMuted,
  type PrendaProduct,
} from '../../lib/prenda'
import { totalStock } from '../../lib/stock'

export async function getStaticPaths() {
  const products = getCollection('products-seo')

  return (await products).map(({ data: product }) => ({
    params: {
      slug: product.slug,
    },
    props: {
      product,
    },
  }))
}

const { product } = Astro.props

const prenda: PrendaProduct = {
  slug: product.slug,
  base_price: product.base_price,
  pieza_unica: product.pieza_unica,
  product_variants: product.product_variants.map((variant) => ({
    id: variant.id,
    size: variant.size,
    color: variant.color,
    color_hex: variant.color_hex,
    stock_quantity: variant.stock_quantity,
    price: variant.price,
  })),
}

const selection = initialSelection(prenda)
const sizes = sizeChoices(prenda, selection)
const colors = colorChoices(prenda, selection)
const view = cardView(prenda)
const ready = canAdd(prenda, selection)
const cap = quantityCap(prenda, selection)
const queda = quedaUnoTexto(prenda, selection)
const muted = priceMuted(prenda, selection)
const stepperOff = stepperMuted(prenda)

const tienda = (await getCollection('tienda'))[0]?.data
const textoEnvio = tienda?.texto_envio.trim() || 'A coordinar'

const imageUrl =
  product.image?.formats?.large?.url
  ?? product.image?.formats?.medium?.url
  ?? product.image?.formats?.small?.url
  ?? product.image?.url

const photos = imageUrl ? [imageUrl] : []
const photoAlt = product.image?.alternativeText?.trim() || ''

const description = `${product.name} - ${product.description || 'Producto de calidad en nuestra tienda'}`

const labelClass =
  view.label === 'PIEZA ÚNICA' ? 'border border-borde-control bg-superficie text-texto'
  : view.label === 'ÚLTIMA UNIDAD' ? 'bg-aviso-fondo text-aviso'
  : view.label === 'SIN STOCK' ? 'bg-error-fondo text-error'
  : ''

function chipClass(enabled: boolean, selected: boolean): string {
  const base = 'inline-flex min-h-minimo items-center justify-center gap-2 rounded-medio px-3 texto-etiqueta'
  if (!enabled) return `${base} bg-superficie-hundida text-texto-deshabilitado`
  if (selected) return `${base} bg-acento text-acento-texto`
  return `${base} border border-borde-control bg-superficie text-texto`
}

function swatchStyle(hex: string | null): string | undefined {
  if (!hex || !/^#[0-9A-Fa-f]{6}$/.test(hex)) return undefined
  return `background-color: ${hex}`
}

const datosJson = JSON.stringify(prenda).replace(/</g, '\\u003c')

const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.name,
  ...(imageUrl ? { image: imageUrl } : {}),
  description: product.description || product.name,
  offers: {
    '@type': 'Offer',
    url: Astro.url.href,
    priceCurrency: 'ARS',
    price: product.base_price,
    availability: totalStock(prenda) > 0
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
  },
}
---

<Base title={`${product.name} - Mi Tienda`} description={description}>
  <Fragment slot="head">
    <meta name="keywords" content={`${product.name}, producto, tienda, ecommerce`} />
    <meta property="og:type" content="product" />
    <meta property="og:title" content={`${product.name} - Mi Tienda`} />
    <meta property="og:description" content={product.description || `Descubre ${product.name} en nuestra tienda`} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${product.name} - Mi Tienda`} />
    <meta name="twitter:description" content={product.description || `Descubre ${product.name} en nuestra tienda`} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  </Fragment>

  <div class="flex flex-col gap-4 py-4" data-prenda>
    <a
      href="/"
      data-volver
      class="inline-flex min-h-minimo items-center self-start texto-etiqueta text-texto no-underline"
    >
      ‹ Volver
    </a>

    {photos.length === 0 && (
      <div class="aspect-square w-full rounded-grande bg-superficie-hundida" role="img" aria-label="Sin foto"></div>
    )}

    {photos.length === 1 && (
      <img
        src={photos[0]}
        alt={photoAlt}
        class="aspect-square w-full rounded-grande bg-superficie-hundida object-cover"
        width="358"
        height="358"
      />
    )}

    {photos.length > 1 && (
      <div>
        <div class="flex snap-x snap-mandatory overflow-x-auto rounded-grande" data-galeria>
          {photos.map((src, index) => (
            <img
              src={src}
              alt={photoAlt}
              class="aspect-square w-full shrink-0 snap-start bg-superficie-hundida object-cover"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
        <div class="flex justify-center">
          {photos.map((_, index) => (
            <button
              type="button"
              class="inline-flex size-minimo items-center justify-center"
              data-punto={index}
              aria-label={`Foto ${index + 1} de ${photos.length}`}
              aria-current={index === 0 ? 'true' : 'false'}
            >
              <span
                data-punto-marca
                class:list={['size-2 rounded-full', index === 0 ? 'bg-texto' : 'bg-borde']}
              ></span>
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="flex flex-col gap-2">
      <h1 class="texto-titulo text-texto">{product.name}</h1>
      <p
        data-precio
        class:list={['texto-precio', muted ? 'text-texto-secundario' : 'text-texto']}
        aria-live="polite"
      >
        {priceText(prenda, selection)}
      </p>
      {view.label && (
        <p>
          <span class:list={['inline-flex h-6 items-center rounded-chico px-2 texto-etiqueta-chica', labelClass]}>
            {view.label}
          </span>
        </p>
      )}
    </div>

    {sizes.length > 0 && (
      <div>
        <p id="talle-label" class="texto-etiqueta text-texto">Talle</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="talle-label">
          {sizes.map((choice) => {
            const selected = selection.size === choice.value && choice.enabled
            return (
              <button
                type="button"
                class={chipClass(choice.enabled, selected)}
                data-talle
                data-valor={choice.value}
                aria-pressed={selected ? 'true' : 'false'}
                aria-disabled={choice.enabled ? undefined : 'true'}
              >
                <span data-nombre class:list={[!choice.enabled && 'line-through']}>{choice.value}</span>
              </button>
            )
          })}
        </div>
      </div>
    )}

    {colors.length > 0 && (
      <div>
        <p id="color-label" class="texto-etiqueta text-texto">Color</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="color-label">
          {colors.map((choice) => {
            const selected = selection.color === choice.value && choice.enabled
            return (
              <button
                type="button"
                class={chipClass(choice.enabled, selected)}
                data-color
                data-valor={choice.value}
                aria-pressed={selected ? 'true' : 'false'}
                aria-disabled={choice.enabled ? undefined : 'true'}
              >
                <span
                  class="size-4 shrink-0 rounded-full border border-borde"
                  style={swatchStyle(choice.colorHex)}
                  aria-hidden="true"
                ></span>
                <span data-nombre class:list={[!choice.enabled && 'line-through']}>{choice.value}</span>
              </button>
            )
          })}
        </div>
      </div>
    )}

    <div>
      <p id="cantidad-label" class="texto-etiqueta text-texto">Cantidad</p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <div
          data-cantidad-caja
          class:list={[
            'inline-flex items-center rounded-medio border',
            stepperOff ? 'border-borde bg-superficie-hundida' : 'border-borde-control bg-superficie',
          ]}
          aria-labelledby="cantidad-label"
        >
          <button
            type="button"
            data-bajar
            class="inline-flex size-minimo items-center justify-center texto-etiqueta text-texto-deshabilitado"
            aria-label="Bajar cantidad"
            aria-disabled="true"
          >
            −
          </button>
          <span
            data-cantidad
            class:list={[
              'min-w-8 text-center texto-etiqueta tabular-nums',
              stepperOff ? 'text-texto-deshabilitado' : 'text-texto',
            ]}
            aria-live="polite"
          >1</span>
          <button
            type="button"
            data-subir
            class:list={[
              'inline-flex size-minimo items-center justify-center texto-etiqueta',
              stepperOff || cap <= 1 ? 'text-texto-deshabilitado' : 'text-texto',
            ]}
            aria-label="Subir cantidad"
            aria-disabled={stepperOff || cap <= 1 ? 'true' : 'false'}
          >
            +
          </button>
        </div>
        <p data-queda class="texto-cuerpo-chico text-aviso" hidden={queda === null}>Queda 1</p>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <button
        type="button"
        data-agregar
        class="inline-flex min-h-cta w-full items-center justify-center rounded-medio bg-acento px-4 text-acento-texto texto-etiqueta disabled:bg-superficie-hundida disabled:text-texto-deshabilitado"
        disabled={!ready}
        aria-describedby={showChooseHint(prenda, selection) ? 'elegir-talle-color' : undefined}
      >
        {addButtonLabel(prenda)}
      </button>
      <p
        id="elegir-talle-color"
        data-ayuda
        class="texto-cuerpo-chico text-center text-texto-secundario"
        hidden={!showChooseHint(prenda, selection)}
      >
        Elegí talle y color
      </p>
    </div>

    {product.description && (
      <p class="texto-cuerpo text-texto">{product.description}</p>
    )}

    <p class="texto-cuerpo text-texto-secundario">Envío: {textoEnvio}</p>

    <script id="prenda-datos" type="application/json" is:inline set:html={datosJson}></script>
    <script>
      import { initPrenda } from '../../scripts/prenda-ui.ts'
      initPrenda()
    </script>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</Base>
