---
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
    const products = getCollection('products-seo')
    
    return (await products).map(({data: product}) => ({
        params: {
            slug: product.slug
        },
        props: {
            product
        }
    }))
}

const { product } = Astro.props
const { slug } = Astro.params
---

<html>
<head>
  <title>{product.name} - Mi Tienda</title>
</head>
<body>
  <h1>{product.name}</h1>
  <p>Precio: ${product.base_price}</p>
  <p>Slug desde params: {slug}</p>
</body>
</html>