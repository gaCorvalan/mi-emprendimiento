---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
    const products = getCollection('products-seo')

    return (await products).map(({data: product}) => ({
        params: {
            slug: product.slug
        },
        props: {
            product
        }
    }))
}

const { product } = Astro.props

const imageUrl =
  product.image?.formats?.large?.url
  ?? product.image?.formats?.medium?.url
  ?? product.image?.formats?.small?.url
  ?? product.image?.url

const description = `${product.name} - ${product.description || 'Producto de calidad en nuestra tienda'}`

const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.name,
  ...(imageUrl ? { image: imageUrl } : {}),
  description: product.description || product.name,
  offers: {
    '@type': 'Offer',
    url: Astro.url.href,
    priceCurrency: 'ARS',
    price: product.base_price,
    availability: 'https://schema.org/InStock',
  },
}
---

<Base title={`${product.name} - Mi Tienda`} description={description}>
  <Fragment slot="head">
    <meta name="keywords" content={`${product.name}, producto, tienda, ecommerce`} />
    <meta property="og:type" content="product" />
    <meta property="og:title" content={`${product.name} - Mi Tienda`} />
    <meta property="og:description" content={product.description || `Descubre ${product.name} en nuestra tienda`} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${product.name} - Mi Tienda`} />
    <meta name="twitter:description" content={product.description || `Descubre ${product.name} en nuestra tienda`} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
  </Fragment>

  <div class="py-8">
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-texto-secundario">
        <li>
          <a href="/" class="hover:text-texto rounded-chico px-1">Inicio</a>
        </li>
        <li class="flex items-center">
          <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
          <span class="font-medium text-texto">{product.name}</span>
        </li>
      </ol>
    </nav>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <div class="aspect-square">
        {imageUrl ? (
          <img
            src={imageUrl}
            alt={`Imagen del producto ${product.name}`}
            class="w-full h-full object-cover rounded-medio shadow-1 bg-superficie"
            loading="eager"
          />
        ) : (
          <div class="w-full h-full rounded-medio shadow-1 bg-acento text-acento-texto flex items-center justify-center">
            <span class="font-semibold text-6xl">
              {product.name.charAt(0).toUpperCase()}
            </span>
          </div>
        )}
      </div>

      <div class="flex flex-col justify-start space-y-6">
        <header>
          <h1 class="text-3xl sm:text-4xl font-semibold text-texto leading-tight">
            {product.name}
          </h1>
        </header>

        <div class="flex items-center space-x-4">
          <span class="text-3xl font-semibold text-texto tabular-nums">
            ${product.base_price?.toLocaleString('es-AR') || 'Precio no disponible'}
          </span>
          <span class="texto-etiqueta bg-exito-fondo text-exito px-2 py-1 rounded-pastilla">
            Precio final
          </span>
        </div>

        {product.description && (
          <div class="max-w-none">
            <h2 class="text-xl font-semibold text-texto mb-3">Descripción</h2>
            <p class="texto-cuerpo text-texto">
              {product.description}
            </p>
          </div>
        )}

        <div class="bg-superficie-hundida rounded-medio p-6 space-y-4">
          <h2 class="text-lg font-semibold text-texto">Detalles del producto</h2>
          <dl class="grid grid-cols-1 gap-3 text-sm">
            <div class="flex justify-between">
              <dt class="font-medium text-texto-secundario">SKU:</dt>
              <dd class="text-texto">{product.slug}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="font-medium text-texto-secundario">Disponibilidad:</dt>
              <dd class="text-exito font-medium">En stock</dd>
            </div>
          </dl>
        </div>

        <div class="space-y-4 pt-6">
          <button
            type="button"
            class="w-full min-h-cta bg-acento text-acento-texto font-semibold py-4 px-6 rounded-medio"
            aria-describedby="add-to-cart-description"
          >
            Comprar
          </button>
          <p id="add-to-cart-description" class="texto-cuerpo text-texto-secundario text-center">
            Envío gratis en compras mayores a $50.000
          </p>
        </div>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
</Base>
