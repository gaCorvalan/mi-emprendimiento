---
import { getCollection } from "astro:content"

const productos = await getCollection('products-seo')
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<h1>Productos</h1>
		<ul>
			{
				productos.map(({data: product}) => (
					<li>
						<a href={`/productos/${product.slug}`} target="_blank" rel="noopener noreferrer">{product.slug}</a>
					</li>
				))
			}
		</ul>
	</body>
</html>
